{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schemas/protocol_revision.v1.schema.json",
  "title": "SYNAPSE Experiment Protocol Revision v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "protocol_id",
    "revision",
    "status",
    "analysis_intent",
    "question",
    "hypothesis",
    "biological_unit",
    "simulation_unit",
    "sources",
    "model",
    "conditions",
    "stimulus_schedule",
    "measurement_window",
    "seeds",
    "analysis",
    "resources"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "frozen", "amended"]
    },
    "analysis_intent": {
      "type": "string",
      "enum": ["exploratory", "confirmatory"]
    },
    "question": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "biological_unit": { "type": "string", "minLength": 1 },
    "simulation_unit": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "release", "manifest_sha256"],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "release": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "revision", "parameter_manifest_sha256", "backend"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "parameter_manifest_sha256": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "interventions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "interventions": { "type": "array" }
        }
      }
    },
    "stimulus_schedule": {},
    "measurement_window": {},
    "seeds": {
      "type": "object",
      "required": ["strategy", "master", "replicates"],
      "properties": {
        "strategy": { "type": "string", "enum": ["paired", "independent"] },
        "master": {},
        "replicates": {}
      }
    },
    "analysis": {
      "type": "object",
      "required": [
        "primary_endpoint",
        "estimand",
        "uncertainty_method",
        "multiplicity_policy",
        "exclusion_policy",
        "acceptance_criteria"
      ]
    },
    "resources": {
      "type": "object",
      "required": ["max_wall_seconds", "max_output_bytes"]
    }
  }
}
