{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.local/schemas/dataset_manifest.v1.schema.json",
  "title": "SYNAPSE Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "release",
    "species",
    "life_stage",
    "sex",
    "specimen_id",
    "coverage",
    "source_uri",
    "source_reference",
    "retrieved_at_utc",
    "license",
    "attribution",
    "is_synthetic_fixture",
    "files",
    "adapter_version",
    "transforms",
    "quality_report",
    "known_limitations",
    "unknown_field_reasons"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 },
    "species": { "type": "string", "minLength": 1 },
    "life_stage": { "type": ["string", "null"] },
    "sex": { "type": ["string", "null"] },
    "specimen_id": { "type": ["string", "null"] },
    "coverage": { "type": "string", "minLength": 1 },
    "source_uri": { "type": "string", "minLength": 1 },
    "source_reference": { "type": "string", "minLength": 1 },
    "retrieved_at_utc": { "type": "string", "format": "date-time" },
    "license": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "is_synthetic_fixture": { "type": "boolean" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256", "upstream_checksum"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "upstream_checksum": { "type": ["string", "null"] }
        }
      }
    },
    "parent_raw_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "uri", "bytes", "sha256", "upstream_checksum"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "upstream_checksum": { "type": ["string", "null"] }
        }
      }
    },
    "adapter_version": { "type": "string", "minLength": 1 },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "description", "input_rows", "output_rows", "rejected_rows"],
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_rows": { "type": "integer", "minimum": 0 },
          "output_rows": { "type": "integer", "minimum": 0 },
          "rejected_rows": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "quality_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "neuron_count",
        "connection_count",
        "total_synapse_count",
        "quarantined_rows",
        "checks"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "neuron_count": { "type": "integer", "minimum": 0 },
        "connection_count": { "type": "integer", "minimum": 0 },
        "total_synapse_count": { "type": "integer", "minimum": 0 },
        "quarantined_rows": { "type": "integer", "minimum": 0 },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unknown_field_reasons": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
