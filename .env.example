# Non-secret environment placeholders for SYNAPSE (local-first defaults)
SYNAPSE_DATA_DIR=data
SYNAPSE_RUNS_DIR=runs
SYNAPSE_PROTOCOLS_DIR=research/protocols
SYNAPSE_OFFLINE=1

# Database URL (local SQLite default; PostgreSQL example below for Docker Compose)
# SYNAPSE_DATABASE_URL=postgresql+psycopg://synapse:replace_with_local_dev_password@127.0.0.1:5432/synapse
SYNAPSE_DATABASE_URL=sqlite:///runs/synapse_lab.sqlite3

# Loopback-only HTTP server settings & restrictive CORS
SYNAPSE_API_HOST=127.0.0.1
SYNAPSE_API_PORT=8000
SYNAPSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=replace_with_local_dev_password

# Graphify local code-only navigation defaults
GRAPHIFY_BACKEND=none
GRAPHIFY_QUERY_LOG_DISABLE=1
